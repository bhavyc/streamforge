# StreamForge Environment Configuration

# Application Port
PORT=3000
NODE_ENV=development

# Redis Broker (BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Storage Driver: 'local' or 's3'
STORAGE_DRIVER=local

# AWS S3 / MinIO Configuration (Required only when STORAGE_DRIVER=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-media-transcode-bucket
# Optional custom endpoint (e.g., http://localhost:9000 for MinIO)
# AWS_S3_ENDPOINT=http://localhost:9000
