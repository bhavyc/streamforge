# StreamForge Environment Configuration

# Application Port
PORT=3000
NODE_ENV=development

# Redis Broker (BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Storage Driver: 'local' or 's3'
STORAGE_DRIVER=local

# AWS S3 / Cloudflare R2 / Supabase Storage Configuration (Required only when STORAGE_DRIVER=s3)
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET=streamforge-media
# Custom S3 Endpoint (e.g. Supabase, R2, MinIO)
AWS_S3_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
# Public CDN / Storage URL for direct browser streaming
AWS_S3_CUSTOM_DOMAIN=https://your-project.supabase.co/storage/v1/object/public/streamforge-media
